<UserControl x:Class="CheckDlc.Views.CheckDlcSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:CheckDlc="clr-namespace:CheckDlc"
             xmlns:Steam="clr-namespace:CommonPluginsControls.Stores.Steam"
             xmlns:Epic="clr-namespace:CommonPluginsControls.Stores.Epic"
             xmlns:Gog="clr-namespace:CommonPluginsControls.Stores.Gog"
             xmlns:stores="clr-namespace:CommonPluginsControls.Stores"
             xmlns:controls="clr-namespace:CommonPluginsControls.Controls"
             mc:Ignorable="d" d:DesignWidth="650"
             d:DataContext="{d:DesignInstance CheckDlc:CheckDlcSettingsViewModel}">

    <Grid Margin="20">
        <Grid.Resources>
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        </Grid.Resources>

        <TabControl Name="tcSettings">
            <!-- General -->
            <TabItem Header="{DynamicResource LOCCheckDlc}">
                <ScrollViewer Margin="0,10,0,0"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <!-- Library import -->
                        <Border Style="{StaticResource SectionBorder}">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource LOCCommonDataSectionTitle}"
                                           Style="{StaticResource SectionHeaderText}" />
                                <CheckBox Style="{StaticResource ModernCheckBox}"
                                          IsChecked="{Binding Settings.AutoImport}"
                                          Content="{DynamicResource LOCCommonAutoImport}" />
                                <CheckBox Style="{StaticResource ModernCheckBox}"
                                          Margin="0,4,0,0"
                                          IsChecked="{Binding Settings.MenuInExtensions}"
                                          Content="{DynamicResource LOCCommonMenuInExtensions}" />
                            </StackPanel>
                        </Border>

                        <!-- Tags -->
                        <Border Style="{StaticResource SectionBorder}">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource LOCCommonTagSectionTitle}"
                                           Style="{StaticResource SectionHeaderText}" />
                                <Grid>
                                    <CheckBox Name="cbEnableTag"
                                              Style="{StaticResource ModernCheckBox}"
                                              IsChecked="{Binding Settings.EnableTag}"
                                              Content="{DynamicResource LOCCheckDlcAddTagDescription}"
                                              VerticalAlignment="Center" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Content="{DynamicResource LOCAddTitle}" 
                                                VerticalAlignment="Center"
                                                Margin="0,0,10,0"
                                                Click="ButtonAddTag_Click"
                                                IsEnabled="{Binding ElementName=cbEnableTag, Path=IsChecked}" />
                                        <Button Content="{DynamicResource LOCRemoveTitle}" 
                                                VerticalAlignment="Center"
                                                Click="ButtonRemoveTag_Click"
                                                IsEnabled="{Binding ElementName=cbEnableTag, Path=IsChecked}" />
                                    </StackPanel>
                                </Grid>
                                <CheckBox Style="{StaticResource ModernCheckBox}"
                                          IsChecked="{Binding Settings.EnableTagAllDlc}"
                                          IsEnabled="{Binding ElementName=cbEnableTag, Path=IsChecked}"
                                          Content="{DynamicResource LOCCheckDlcAddTagAllDlc}" />
                            </StackPanel>
                        </Border>

                        <!-- Game metadata -->
                        <Border Style="{StaticResource SectionBorder}">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource LOCCheckDlcSettingsMetadataSection}"
                                           Style="{StaticResource SectionHeaderText}" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" MinWidth="180" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="280" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="{DynamicResource LOCCheckDlcFeatureDlc}"
                                               Style="{StaticResource ViewColumnLabelText}"
                                               VerticalAlignment="Center" />
                                    <ComboBox Grid.Column="2"
                                              SelectedItem="{Binding Settings.DlcFeature}"
                                              ItemsSource="{Binding Features}"
                                              DisplayMemberPath="Name"
                                              Name="PART_FeatureDlc" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Price change notifications -->
                        <Border Style="{StaticResource SectionBorder}">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource LOCCheckDlcPriceNotification}"
                                           Style="{StaticResource SectionHeaderText}" />
                                <CheckBox Style="{StaticResource ModernCheckBox}"
                                          IsChecked="{Binding Settings.PriceNotification}"
                                          Content="{DynamicResource LOCCheckDlcShowNotification}" />
                            </StackPanel>
                        </Border>

                        <!-- Store currencies (price display) -->
                        <Border Style="{StaticResource SectionBorder}" Margin="0"
                                Visibility="{Binding ShowCurrencySection, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource LOCCheckDlcSettingsCurrencySection}"
                                           Style="{StaticResource SectionHeaderText}" />
                                <TextBlock Text="{DynamicResource LOCCheckDlcSettingsCurrencyDescription}"
                                           TextWrapping="Wrap"
                                           Opacity="0.75"
                                           Margin="0,0,0,12" />
                                <Grid Visibility="{Binding IsGogStoreEnabled, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}"
                                      Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" MinWidth="180" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="280" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="{DynamicResource LOCCheckDlcDefineGogCurrency}"
                                               Style="{StaticResource ViewColumnLabelText}"
                                               VerticalAlignment="Center" />
                                    <ComboBox Grid.Column="2"
                                              SelectedItem="{Binding Settings.GogCurrency}"
                                              DisplayMemberPath="text"
                                              Name="PART_GogCurrency" />
                                </Grid>
                                <Grid Visibility="{Binding IsOriginStoreEnabled, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" MinWidth="180" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="280" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="{DynamicResource LOCCheckDlcDefineOriginCurrency}"
                                               Style="{StaticResource ViewColumnLabelText}"
                                               VerticalAlignment="Center" />
                                    <ComboBox Grid.Column="2"
                                              SelectedItem="{Binding Settings.OriginCurrency}"
                                              DisplayMemberPath="text"
                                              Name="PART_OriginCurrency" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Theme integration -->
            <TabItem Header="{DynamicResource LOCCommonIntegration}">
                <ScrollViewer Margin="0,10,0,0"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource LOCCommonControlsAvailable}"
                                   Style="{StaticResource SectionHeaderText}"
                                   Margin="0,0,0,4" />
                        <TextBlock Text="{DynamicResource LOCCheckDlcSettingsIntegrationDescription}"
                                   TextWrapping="Wrap"
                                   Opacity="0.75"
                                   Margin="0,0,0,16" />

                        <Border Style="{StaticResource SectionBorder}">
                            <StackPanel>
                                <CheckBox Name="PART_IntegrationButton"
                                          Style="{StaticResource ModernCheckBox}"
                                          IsChecked="{Binding Settings.EnableIntegrationButton}"
                                          Content="{DynamicResource LOCCommonControlsPluginButtonShow}" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SectionBorder}" Margin="0">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource LOCCommonIntegrationListOptions}"
                                           Style="{StaticResource SectionHeaderText}" />
                                <CheckBox Style="{StaticResource ModernCheckBox}"
                                          Margin="16,0,0,4"
                                          IsChecked="{Binding Settings.EnableIntegrationListDlcAll}"
                                          Content="{DynamicResource LOCCheckDlcEnableListDlcAll}" />
                                <CheckBox Style="{StaticResource ModernCheckBox}"
                                          Margin="16,0,0,4"
                                          IsChecked="{Binding Settings.EnableIntegrationListDlcOwned}"
                                          Content="{DynamicResource LOCCheckDlcEnableListDlcOwned}" />
                                <CheckBox Style="{StaticResource ModernCheckBox}"
                                          Margin="16,0,0,0"
                                          IsChecked="{Binding Settings.EnableIntegrationListDlcNotOwned}"
                                          Content="{DynamicResource LOCCheckDlcEnableListDlNotOwned}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Ignored DLC -->
            <TabItem Header="{DynamicResource LOCCommonIgnoredItems}">
                <DockPanel Margin="0,10,0,0" LastChildFill="True">
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <TextBlock Text="{DynamicResource LOCCheckDlcSettingsIgnoredDescription}"
                                   TextWrapping="Wrap"
                                   Opacity="0.75" />
                    </StackPanel>
                    <ListBox ItemsSource="{Binding Settings.IgnoredList}"
                             Name="PART_IgnoredList"
                             MinHeight="120">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <controls:TextBlockTrimmed Text="{Binding}" VerticalAlignment="Center" />
                                    <Button Grid.Column="1"
                                            Tag="{Binding}"
                                            Click="Button_RemoveIgnored_Click"
                                            ToolTip="{DynamicResource LOCRemoveTitle}"
                                            Content="&#xEC53;"
                                            FontFamily="{DynamicResource FontIcoFont}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </TabItem>

            <!-- Manually owned DLC -->
            <TabItem Header="{DynamicResource LOCCheckDlcManuallyOwned}">
                <DockPanel Margin="0,10,0,0" LastChildFill="True">
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <TextBlock Text="{DynamicResource LOCCheckDlcSettingsManuallyOwnedDescription}"
                                   TextWrapping="Wrap"
                                   Opacity="0.75" />
                    </StackPanel>
                    <ListBox ItemsSource="{Binding Settings.ManuallyOwneds}"
                             Name="PART_ManuallyOwnedList"
                             MinHeight="120">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <controls:TextBlockTrimmed Text="{Binding}" VerticalAlignment="Center" />
                                    <Button Grid.Column="1"
                                            Tag="{Binding}"
                                            Click="Button_RemoveManuallyOwned_Click"
                                            ToolTip="{DynamicResource LOCRemoveTitle}"
                                            Content="&#xEC53;"
                                            FontFamily="{DynamicResource FontIcoFont}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </TabItem>

            <!-- Store libraries -->
            <TabItem Header="{DynamicResource LOCLibraries}">
                <stores:StoresSettingsView x:Name="StoresSettings" />
            </TabItem>
        </TabControl>

        <!-- Panels are registered into StoresSettingsView at runtime (only supported stores). -->
        <StackPanel x:Name="StorePanelsHost" Visibility="Collapsed">
            <Steam:PanelView x:Name="SteamPanel" ForceAuth="True"
                             UseApi="{Binding DataContext.Settings.SteamStoreSettings.UseApi, Mode=TwoWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}"
                             UseAuth="{Binding DataContext.Settings.SteamStoreSettings.UseAuth, Mode=TwoWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" />

            <Epic:PanelView x:Name="EpicPanel" ForceAuth="True"
                            UseAuth="{Binding DataContext.Settings.EpicStoreSettings.UseAuth, Mode=TwoWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" />

            <Gog:PanelView x:Name="GogPanel" ForceAuth="True"
                           UseAuth="{Binding DataContext.Settings.GogStoreSettings.UseAuth, Mode=TwoWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" />
        </StackPanel>
    </Grid>
</UserControl>
