<UserControl x:Class="CheckDlc.Views.CheckDlcFreeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:CheckDlc.Views"
             xmlns:commands="clr-namespace:CommonPluginsShared.Commands"
             xmlns:controlsShared="clr-namespace:CommonPluginsShared.Controls"
             xmlns:convertersshared="clr-namespace:CommonPluginsShared.Converters"
             xmlns:converters="clr-namespace:CommonPlayniteShared.Converters"
             xmlns:controls="clr-namespace:CommonPluginsControls.Controls"
             mc:Ignorable="d"
             d:DesignHeight="600"
             d:DesignWidth="1024">

    <UserControl.Resources>
        <convertersshared:DefaultIconConverter x:Key="DefaultIconConverter" />
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <converters:InvertedBooleanToVisibilityConverter x:Key="InvertedBooleanToVisibilityConverter" />

        <Style x:Key="FreeDlcRowIconButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="FontFamily" Value="{DynamicResource FontIcoFont}" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <DockPanel Margin="10" LastChildFill="True">

        <!-- Footer: total count and refresh -->
        <Grid DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Style="{DynamicResource BaseTextBlockStyle}"
                           Text="{DynamicResource LOCCommonTotalFound}"
                           VerticalAlignment="Center" />
                <TextBlock x:Name="PART_TotalFoundCount"
                           Style="{DynamicResource BaseTextBlockStyle}"
                           Margin="10,0,0,0"
                           Width="40"
                           TextAlignment="Right"
                           VerticalAlignment="Center" />
            </StackPanel>

            <Button HorizontalAlignment="Right"
                    Content="{DynamicResource LOCCommonRefreshAllData}"
                    Click="Button_Click_Refresh" />
        </Grid>

        <!-- Free DLC list -->
        <Border BorderBrush="{DynamicResource NormalBorderBrush}"
                BorderThickness="{DynamicResource ControlBorderThickness}"
                CornerRadius="{DynamicResource ControlCornerRadius}">
            <controlsShared:ListViewExtend x:Name="PART_ListviewDlc"
                                           FontSize="{DynamicResource FontSize}"
                                           Style="{StaticResource {x:Type ListView}}"
                                           SortingEnable="True"
                                           SortingSortDirection="Ascending"
                                           SortingDefaultDataName="Name"
                                           ColumnManagementMenuEnable="False"
                                           ScrollViewer.HorizontalScrollBarVisibility="Auto">
                <ListView.View>
                    <GridView>

                        <!-- Icon -->
                        <GridViewColumn Width="50" x:Name="lvGameIcon">
                            <GridViewColumnHeader Content="{DynamicResource LOCGameIconTitle}"
                                                  Tag="noSort"
                                                  Padding="8,6" />
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Image Width="32"
                                           HorizontalAlignment="Center"
                                           Source="{Binding Icon, Converter={StaticResource DefaultIconConverter}}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <!-- Hidden sort column (Name) -->
                        <GridViewColumn Width="0" DisplayMemberBinding="{Binding Name}">
                            <controlsShared:GridViewColumnHeaderExtend Style="{StaticResource {x:Type GridViewColumnHeader}}"
                                                                       IsHitTestVisible="False" />
                        </GridViewColumn>

                        <!-- Game name -->
                        <GridViewColumn Width="270"
                                        x:Name="lvGameName"
                                        controlsShared:ListViewColumnOptions.SortMemberPath="Name">
                            <GridViewColumnHeader Name="lvName"
                                                  Content="{DynamicResource LOCGameNameTitle}"
                                                  Tag="Name"
                                                  Padding="8,6" />
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="4,2">
                                        <TextBlock Visibility="{Binding GameExist, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <Hyperlink Command="{x:Static commands:CommandsNavigation.GoToGame}"
                                                       CommandParameter="{Binding Id}">
                                                <controls:TextBlockTrimmed Text="{Binding Name}"
                                                                             Style="{DynamicResource ListExtendStyleTextBlock}" />
                                            </Hyperlink>
                                        </TextBlock>
                                        <TextBlock Visibility="{Binding GameExist, Converter={StaticResource InvertedBooleanToVisibilityConverter}}">
                                            <controls:TextBlockTrimmed Text="{Binding Name}"
                                                                         Style="{DynamicResource ListExtendStyleTextBlock}" />
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <!-- Hidden sort column (Source) -->
                        <GridViewColumn Width="0" DisplayMemberBinding="{Binding SourceName}">
                            <controlsShared:GridViewColumnHeaderExtend Style="{StaticResource {x:Type GridViewColumnHeader}}"
                                                                       IsHitTestVisible="False" />
                        </GridViewColumn>

                        <!-- Store source -->
                        <GridViewColumn Width="75" x:Name="lvGamesSource">
                            <GridViewColumnHeader Name="lvSourceIcon"
                                                  Content="{DynamicResource LOCSourceLabel}"
                                                  Tag="SourceName"
                                                  Padding="8,6" />
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding SourceIcon}"
                                               FontFamily="{DynamicResource CommonFont}"
                                               FontSize="{DynamicResource FontSizeLarger}"
                                               HorizontalAlignment="Center"
                                               ToolTip="{Binding SourceName}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <!-- DLC name -->
                        <GridViewColumn Width="380"
                                        x:Name="lvGameDlc"
                                        controlsShared:ListViewColumnOptions.SortMemberPath="NameDlc">
                            <GridViewColumnHeader Name="lvDlc"
                                                  Content="{DynamicResource LOCCheckDlcDlc}"
                                                  Tag="NameDlc"
                                                  Padding="8,6" />
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <controls:TextBlockTrimmed Margin="4,2"
                                                               Text="{Binding NameDlc}"
                                                               Style="{DynamicResource ListExtendStyleTextBlock}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <!-- Row actions -->
                        <GridViewColumn Width="200" x:Name="lvDlcLink">
                            <GridViewColumnHeader Content="{DynamicResource LOCActionsLabel}"
                                                  Tag="noSort"
                                                  Padding="8,6" />
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal"
                                                Margin="4,0"
                                                Tag="{Binding Id}">

                                        <Button Style="{StaticResource FreeDlcRowIconButtonStyle}"
                                                Tag="{Binding Link}"
                                                Click="Button_Click"
                                                Content="&#xf028;"
                                                ToolTip="{Binding Link}" />

                                        <Button Name="Part_Refresh"
                                                Style="{StaticResource FreeDlcRowIconButtonStyle}"
                                                Tag="{Binding Id}"
                                                Click="Part_Refresh_Click"
                                                Content="&#xec7f;"
                                                ToolTip="{DynamicResource LOCCommonRefreshGameData}" />

                                        <Button Name="Part_Owned"
                                                Tag="{Binding DlcId}"
                                                Click="Part_Owned_Click"
                                                Content="&#xEC4B;"
                                                ToolTip="{DynamicResource LOCCheckDlcIsOwned}">
                                            <Button.Style>
                                                <Style TargetType="{x:Type Button}" BasedOn="{StaticResource FreeDlcRowIconButtonStyle}">
                                                    <Setter Property="IsEnabled" Value="True" />
                                                    <Style.Triggers>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding IsManualOwned}" Value="False" />
                                                                <Condition Binding="{Binding IsOwned}" Value="True" />
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="IsEnabled" Value="False" />
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>

                                        <Button Name="Part_Ignore"
                                                Tag="{Binding DlcId}"
                                                Click="Part_Ignore_Click"
                                                Content="&#xe972;"
                                                FontFamily="{DynamicResource CommonFont}"
                                                ToolTip="{DynamicResource LOCCommonIgnoredItems}"
                                                VerticalAlignment="Center" />
                                    </StackPanel>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                    </GridView>
                </ListView.View>
            </controlsShared:ListViewExtend>
        </Border>
    </DockPanel>
</UserControl>
