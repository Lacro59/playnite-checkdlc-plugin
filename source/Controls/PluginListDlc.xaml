<controls:PluginUserControlExtend x:Class="CheckDlc.Controls.PluginListDlc"
                                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                                  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                                  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                                  xmlns:local="clr-namespace:CheckDlc.Controls"
                                  xmlns:controls="clr-namespace:CommonPluginsShared.Controls"
                                  xmlns:htmlControls="clr-namespace:DescriptionEditor.PlayniteResources.Controls"
                                  xmlns:converters="clr-namespace:CommonPlayniteShared.Converters"
                                  xmlns:pluginConverters="clr-namespace:CommonPluginsShared.Converters"
                                  xmlns:sys="clr-namespace:System;assembly=mscorlib"
                                  mc:Ignorable="d"
                                  d:DesignHeight="400"
                                  d:DesignWidth="800"
                                  Height="{Binding RelativeSource={RelativeSource AncestorType=ContentControl}, Path=Height}"
                                  d:DataContext="{d:DesignInstance local:PPluginListDlcDataContext, IsDesignTimeCreatable=True}">

    <controls:PluginUserControlExtend.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <converters:InvertedBoolenConverter x:Key="InvertedBoolenConverter" />
        <converters:InvertedBooleanToVisibilityConverter x:Key="InvertedBooleanToVisibilityConverter" />
        <pluginConverters:ValueOperationConverter x:Key="ValueOperationConverter" />

        <Style x:Key="DlcRowTitleLabelStyle" TargetType="{x:Type Label}" BasedOn="{StaticResource {x:Type Label}}">
            <Setter Property="FontSize" Value="{DynamicResource FontSizeLarge}" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="DlcRowLinkButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="FontFamily" Value="{DynamicResource FontIcoFont}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="DlcRowTransparentExpanderStyle" TargetType="{x:Type Expander}" BasedOn="{StaticResource {x:Type Expander}}">
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <Style x:Key="DlcRowDescriptionScrollStyle" TargetType="{x:Type ScrollViewer}" BasedOn="{StaticResource {x:Type ScrollViewer}}">
            <Setter Property="IsEnabled" Value="True" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsHidden}" Value="True">
                    <Setter Property="IsEnabled" Value="False" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </controls:PluginUserControlExtend.Resources>

    <Grid x:Name="PART_GridContener">
        <ListBox x:Name="PART_Dlcs"
                 Height="{Binding ElementName=PART_GridContener, Path=ActualHeight}"
                 ItemsSource="{Binding ItemsSource}">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel IsVirtualizing="True" />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>

            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="10" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Header row: title, ownership / price, store link -->
                        <Label Grid.Row="0"
                               Grid.Column="2"
                               Content="{Binding Name, FallbackValue='Game name'}"
                               Style="{StaticResource DlcRowTitleLabelStyle}" />

                        <TextBlock Grid.Row="0"
                                   Grid.Column="4"
                                   Style="{DynamicResource BaseTextBlockStyle}"
                                   Text="{DynamicResource LOCCheckDlcOwned}"
                                   VerticalAlignment="Center"
                                   Visibility="{Binding IsOwned, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=False}" />

                        <StackPanel Grid.Row="0"
                                    Grid.Column="4"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    IsEnabled="{Binding IsOwned, Converter={StaticResource InvertedBoolenConverter}}"
                                    Visibility="{Binding IsOwned, Converter={StaticResource InvertedBooleanToVisibilityConverter}, FallbackValue=False}">
                            <TextBlock Style="{DynamicResource BaseTextBlockStyle}"
                                       Text="{DynamicResource LOCCheckDlcFree}"
                                       VerticalAlignment="Center"
                                       Visibility="{Binding IsFree, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=False}" />

                            <StackPanel Orientation="Horizontal"
                                        Visibility="{Binding IsFree, Converter={StaticResource InvertedBooleanToVisibilityConverter}, FallbackValue=False}">
                                <TextBlock Style="{DynamicResource BaseTextBlockStyle}"
                                           Text="{Binding Price, FallbackValue='10.0€'}"
                                           VerticalAlignment="Center" />
                                <TextBlock Style="{DynamicResource BaseTextBlockStyle}"
                                           Margin="10,0,0,0"
                                           Text="{Binding PriceBase, FallbackValue='20.0€'}"
                                           TextDecorations="Strikethrough"
                                           VerticalAlignment="Center"
                                           Visibility="{Binding IsDiscount, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=True}" />
                            </StackPanel>
                        </StackPanel>

                        <Button Grid.Row="0"
                                Grid.Column="6"
                                Style="{StaticResource DlcRowLinkButtonStyle}"
                                Tag="{Binding Link}"
                                Click="Button_Click"
                                Content="&#xf028;"
                                ToolTip="{Binding Link}" />

                        <!-- Content row: cover and description -->
                        <Image Grid.Row="2"
                               Grid.Column="0"
                               Width="250"
                               Height="120"
                               Source="{Binding ImagePath, IsAsync=True}"
                               Stretch="Fill"
                               RenderOptions.BitmapScalingMode="Linear"
                               VerticalAlignment="Top"
                               IsEnabled="{Binding IsOwned, Converter={StaticResource InvertedBoolenConverter}}" />

                        <Expander Grid.Row="2"
                                  Grid.Column="2"
                                  Grid.ColumnSpan="5"
                                  Header="{DynamicResource LOCGameDescriptionTitle}"
                                  Style="{StaticResource DlcRowTransparentExpanderStyle}"
                                  VerticalAlignment="Top">
                            <ScrollViewer MaxHeight="350"
                                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                                          Style="{StaticResource DlcRowDescriptionScrollStyle}">
                                <htmlControls:HtmlTextView HorizontalAlignment="Center"
                                                           HtmlFontFamily="{DynamicResource FontFamily}"
                                                           HtmlFontSize="{DynamicResource FontSize}"
                                                           HtmlForeground="{DynamicResource TextColor}"
                                                           HtmlText="{Binding Description, FallbackValue='Description HTML'}"
                                                           LinkForeground="{DynamicResource GlyphColor}">
                                    <htmlControls:HtmlTextView.Width>
                                        <MultiBinding Converter="{StaticResource ValueOperationConverter}" ConverterParameter="-">
                                            <Binding ElementName="PART_GridContener" Path="ActualWidth" />
                                            <Binding>
                                                <Binding.Source>
                                                    <sys:Double>400</sys:Double>
                                                </Binding.Source>
                                            </Binding>
                                        </MultiBinding>
                                    </htmlControls:HtmlTextView.Width>
                                </htmlControls:HtmlTextView>
                            </ScrollViewer>
                        </Expander>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</controls:PluginUserControlExtend>
